# ── Chaves de IA ───────────────────────────────────────────────────────────
GEMINI_API_KEY="sua_chave_google_ai_studio_aqui"
OPENAI_API_KEY="sua_chave_openai_aqui"

# ── Supabase ───────────────────────────────────────────────────────────────
# JWT Secret do projeto (Dashboard → Settings → API → JWT Secret). Valida o
# token do usuário logado antes de gastar IA.
SUPABASE_JWT_SECRET="jwt_secret_do_projeto_supabase"

# URL e anon key do projeto, usadas para perguntar ao banco, em nome do próprio
# usuário, se ele tem acesso pago (rpc has_active_access). Sem elas o /chat
# recusa com 503 — falha fechada, de propósito.
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_ANON_KEY="anon_key_do_projeto_supabase"

# ── CORS ───────────────────────────────────────────────────────────────────
# Origens permitidas, separadas por vírgula.
FRONTEND_URL="http://localhost:5173,http://localhost:8080"

# Secrets das Edge Functions. Copie para supabase/.env.local (não versionado)
# preenchendo os valores reais — esse arquivo alimenta o `supabase functions
# serve --env-file supabase/.env.local` durante o desenvolvimento.
#
# Em produção os mesmos valores vão para o projeto com:
#   supabase secrets set --env-file supabase/.env.local

# Segredo do webhook da Cakto. Deve ser IDÊNTICO ao cadastrado no painel da
# Cakto — é ele que a Cakto envia no campo `secret` do corpo, e é a única
# credencial que autentica a chamada. Aceita vários valores separados por
# vírgula durante uma rotação de chave.
CAKTO_WEBHOOK_SECRET=

# (Opcional) IDs dos produtos Cakto que liberam o Aulateca, separados por
# vírgula. Vazio = qualquer venda que chegue com o segredo correto libera
# acesso. Preencher é a proteção para o caso de o mesmo segredo ser reaproveitado
# em outro produto da conta.
CAKTO_PRODUCT_IDS=

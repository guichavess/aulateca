# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Copie para .env.local e preencha. Só variáveis VITE_* chegam ao navegador —
# nunca coloque chaves de IA aqui.

# Supabase — OBRIGATÓRIO. Sem isso o app sobe com tela branca.
# Dashboard → Settings → API. A "publishable/anon key" é pública por design (RLS protege).
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua_anon_key_publica"

# Backend de IA (FastAPI). Em produção, a URL do serviço no Render.
VITE_AI_URL="http://localhost:8000"

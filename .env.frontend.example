# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Copie para .env.local e preencha. Só variáveis VITE_* chegam ao navegador —
# nunca coloque chaves de IA aqui.

# Supabase — OBRIGATÓRIO. Sem isso o app sobe com tela branca.
# Dashboard → Settings → API. A "publishable/anon key" é pública por design (RLS protege).
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua_anon_key_publica"

# Backend de IA (FastAPI). Em produção, a URL do serviço no Render.
VITE_AI_URL="http://localhost:8000"

# Checkout do produto na Cakto. É o destino dos CTAs da landing.
# Sem isto, os botões de compra caem no login em vez de vender.
VITE_CAKTO_CHECKOUT_URL="https://pay.cakto.com.br/SEU-PRODUTO"

# ─── Suporte ──────────────────────────────────────────────────────────────────
# Como o professor fala com a gente. Cada canal some sozinho se ficar vazio —
# e vazio significa cliente pago travado sem ninguém para chamar. Preencher
# ANTES do lançamento, aqui e nas variáveis do Vercel.
VITE_SUPORTE_EMAIL="suporte@seudominio.com.br"
# Só dígitos, com DDI e DDD (o wa.me não aceita máscara).
VITE_SUPORTE_WHATSAPP="5531999998888"

# ─── Monitoramento de erro (Sentry) ───────────────────────────────────────────
# Vazio em dev, de propósito: erro de quem está programando não deve gastar a
# cota do plano gratuito. Em produção, sem isto, toda tela branca é invisível.
# ⚠️ O host do DSN precisa estar liberado em `connect-src` no vercel.json —
# senão o envio é bloqueado pelo CSP em silêncio e o painel fica vazio.
VITE_SENTRY_DSN=""

# ─── Acervo de demonstração ───────────────────────────────────────────────────
# "true" faz o app cair no acervo fictício do bundle quando o banco vem vazio.
# Serve para demo comercial. Em PRODUÇÃO fica desligado: com o Supabase fora do
# ar, ligado, o professor vê a grade cheia e o download morre — o que esconde a
# queda e troca um erro honesto por um produto que só parece funcionar.
VITE_DEMO_FALLBACK="false"

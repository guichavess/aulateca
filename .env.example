# ─── Segredos do backend de IA (FastAPI) ──────────────────────────────────────
# Copie para .env e preencha. NUNCA commite o .env preenchido.

# Chaves das IAs (servidor apenas — jamais expor no frontend)
GEMINI_API_KEY="sua_chave_google_ai_studio"
OPENAI_API_KEY="sua_chave_openai"

# JWT Secret do projeto Supabase: Dashboard → Settings → API → JWT Secret.
# O FastAPI usa isso para validar o usuário logado antes de gastar IA.
SUPABASE_JWT_SECRET="cole_o_jwt_secret_do_supabase_aqui"

# Origens permitidas no CORS (separadas por vírgula). Em produção, o domínio real.
FRONTEND_URL="http://localhost:5173,http://localhost:8080"

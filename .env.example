# ─── Segredos do backend de IA (FastAPI) ──────────────────────────────────────
# Copie para .env e preencha. NUNCA commite o .env preenchido.

# Chaves das IAs (servidor apenas — jamais expor no frontend)
GEMINI_API_KEY="sua_chave_google_ai_studio"
OPENAI_API_KEY="sua_chave_openai"

# JWT Secret do projeto Supabase: Dashboard → Settings → API → JWT Secret.
# O FastAPI usa isso para validar o usuário logado antes de gastar IA.
SUPABASE_JWT_SECRET="cole_o_jwt_secret_do_supabase_aqui"

# Origens permitidas no CORS (separadas por vírgula). Em produção, o domínio real.
FRONTEND_URL="http://localhost:5173,http://localhost:8080"

# ─── Scripts administrativos (criar-admin, upload-atividades) ─────────────────
# Lidos daqui por `scripts/env-local.mjs`, então NÃO precisa passar na linha de
# comando — o que também evita a chave ficar no histórico do PowerShell.
#
# ⚠️  SERVICE ROLE é a chave de maior privilégio do projeto: ela ignora todo o
# RLS. Fica só neste arquivo (gitignorado), na sua máquina. Não vai para o
# frontend, não entra em commit, não circula por e-mail ou chat. Vazou? Rode
# "Reset service role key" no Dashboard na mesma hora.
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="cole_a_service_role_key_aqui"
